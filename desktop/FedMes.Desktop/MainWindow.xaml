<Window x:Class="FedMes.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FedMes.Desktop.Views"
        xmlns:controls="clr-namespace:FedMes.Desktop.Controls"
        xmlns:fedui="clr-namespace:FedMes.Desktop.FedUI3"
        Title="FedMes"
        Width="1240"
        Height="800"
        MinWidth="420"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FedMesBackgroundBrush}"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop"
        SizeChanged="MainWindow_SizeChanged"
        Closing="MainWindow_Closing">
    <Grid>
        <Grid x:Name="MessengerPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="360" />
                <ColumnDefinition x:Name="ConversationColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel"
                    Grid.Column="0"
                    Background="{DynamicResource FedMesSurfaceBrush}"
                    BorderBrush="{DynamicResource FedMesDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ThemeButton" Grid.Column="0" Click="ThemeButton_Click" Style="{StaticResource IconButtonStyle}" FocusVisualStyle="{x:Null}" ToolTip="Сменить тему" AutomationProperties.Name="Сменить тему" Visibility="Collapsed">
                            <TextBlock x:Name="ThemeGlyph"
                                       Width="28" Height="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource FedMesPrimaryTextBrush}"
                                       Text="☾"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FedMesPrimaryTextBrush}" Text="FedMes" />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="{Binding HeaderSubtitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="MainMenuButton" Grid.Column="2" Click="MainMenuButton_Click" Content="⋮" FontSize="24" Style="{StaticResource IconButtonStyle}" ToolTip="Меню FedMes" AutomationProperties.Name="Меню FedMes" />
                    </Grid>
                    <Border Grid.Row="1" Margin="14,4,14,8" Background="{DynamicResource FedMesSecondarySurfaceBrush}" CornerRadius="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="⌕" FontSize="20" />
                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock x:Name="SearchPlaceholderText"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                           IsHitTestVisible="False"
                                           Text="Поиск" />
                                <TextBox x:Name="ChatSearchTextBox"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource FedMesPrimaryTextBrush}"
                                         TextChanged="ChatSearchTextBox_TextChanged"
                                         AutomationProperties.Name="Поиск чатов" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ChatListBox"
                                 ItemsSource="{Binding Chats}"
                                 SelectedItem="{Binding SelectedChat}"
                                 SelectionChanged="ChatListBox_SelectionChanged"
                                 PreviewMouseLeftButtonUp="ChatListBox_PreviewMouseLeftButtonUp"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Список чатов">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Height="68" Padding="8,7" Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource FedMesHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource FedMesHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="54" Height="54">
                                        <Border x:Name="UserAvatar" Width="54" Height="54" Background="{Binding AvatarBrush}" CornerRadius="27">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding AvatarText}" />
                                        </Border>
                                        <Border x:Name="SavedAvatar" Width="54" Height="54" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="27" Visibility="Collapsed">
                                            <Viewbox Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2.6" StrokeLineJoin="Round" Data="M4,2 L16,2 L16,20 L10,15.5 L4,20 Z" />
                                            </Viewbox>
                                        </Border>
                                        <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource FedMesSurfaceBrush}" CornerRadius="7" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                                            <Border Width="10" Height="10" Background="{DynamicResource FedMesOnlineBrush}" CornerRadius="5" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="12,1,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="22" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="ChatTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FedMesNameTextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="{Binding LastMessage}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="{Binding TimeText}" />
                                        <Border Margin="0,7,0,0" Width="22" Height="22" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="11" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="White" Text="{Binding UnreadCountText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                        <Setter TargetName="UserAvatar" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="SavedAvatar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlueTitle}" Value="True">
                                        <Setter TargetName="ChatTitle" Property="Foreground" Value="{DynamicResource FedMesAccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ChatEmptyState"
                                   Margin="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                   Text="Чаты не найдены"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ConversationPanel" Grid.Column="1" Background="{DynamicResource FedMesChatBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource FedMesSurfaceBrush}" BorderBrush="{DynamicResource FedMesDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="BackButtonColumn" Width="0" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackToChatsButton"
                                Grid.Column="0"
                                Content="←"
                                Click="BackToChatsButton_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Назад к чатам"
                                AutomationProperties.Name="Назад к чатам"
                                Visibility="Collapsed" />
                        <Grid Grid.Column="1" Width="46" Height="46">
                            <Border Background="{Binding SelectedChat.AvatarBrush}" CornerRadius="23">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChat.IsFavorites}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding SelectedChat.AvatarText, FallbackValue=F}" />
                            </Border>
                            <Border Background="{DynamicResource FedMesAccentBrush}" CornerRadius="23">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChat.IsFavorites}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="23" Height="23">
                                    <Path Stroke="White" StrokeThickness="2.6" StrokeLineJoin="Round" Data="M4,2 L16,2 L16,20 L10,15.5 L4,20 Z" />
                                </Viewbox>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" Margin="10,5,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedChat.Title, FallbackValue=Выберите чат}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource FedMesNameTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChat.IsBlueTitle}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FedMesAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource FedMesAccentBrush}" Text="{Binding ChatStatusText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="☎" Click="AudioCallButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Аудиозвонок" AutomationProperties.Name="Аудиозвонок" />
                        <Button Grid.Column="4" Content="▣" Click="VideoCallButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Видеозвонок" AutomationProperties.Name="Видеозвонок" />
                        <Button Grid.Column="5" Content="⋮" Click="ChatMenuButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Меню чата" AutomationProperties.Name="Меню чата" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="10,4"
                        Background="{DynamicResource FedMesSelectedBrush}"
                        BorderBrush="{DynamicResource FedMesDividerBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding HasSelectedMessages, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button Content="×" Click="ClearSelectionButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Отменить выбор" AutomationProperties.Name="Отменить выбор" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FedMesPrimaryTextBrush}"
                                   Text="{Binding SelectedMessageCountText}" />
                        <Button Grid.Column="2"
                                Content="✎"
                                Click="EditSelectedButton_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Редактировать"
                                AutomationProperties.Name="Редактировать выбранное сообщение"
                                Visibility="{Binding CanEditSelectedMessage, Converter={StaticResource BoolToVisibility}}" />
                        <Button Grid.Column="3" Content="🗑" Click="DeleteSelectedButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Удалить" AutomationProperties.Name="Удалить выбранные сообщения" />
                    </Grid>
                </Border>

                <Border x:Name="PinnedMessageBar"
                        Grid.Row="2"
                        Padding="16,10"
                        Background="{DynamicResource FedMesSurfaceBrush}"
                        BorderBrush="{DynamicResource FedMesDividerBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource FedMesAccentBrush}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FedMesAccentBrush}" Text="Закреплённое сообщение" />
                            <TextBlock x:Name="PinnedMessageText" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="×" Click="UnpinButton_Click" Style="{StaticResource IconButtonStyle}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                               Text="Выберите чат слева"
                               Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibility}}" />
                    <ListBox x:Name="MessagesListBox"
                             ItemsSource="{Binding Messages}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="24,18"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.ScrollChanged="MessagesScrollViewer_ScrollChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" Loaded="MessageItem_Loaded" Unloaded="MessageItem_Unloaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Background="Transparent"
                                            Tag="{Binding}"
                                            MouseLeftButtonUp="MessageActionLane_MouseLeftButtonUp"
                                            ToolTip="Действия с сообщением">
                                        <Border.ContextMenu>
                                            <ContextMenu Opened="MessageContextMenu_Opened">
                                                <MenuItem Header="Ответить" Click="ReplyMenuItem_Click" />
                                                <MenuItem Header="Переслать" Click="ForwardMenuItem_Click" />
                                                <MenuItem Header="Копировать текст" Click="CopyMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="Редактировать" Click="EditMenuItem_Click" />
                                                <MenuItem Header="Закрепить" Click="PinMenuItem_Click" />
                                                <MenuItem Header="Выбрать" Click="SelectMenuItem_Click" />
                                                <MenuItem Header="Сохранить вложение" Click="SaveMediaMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="Удалить у меня" Click="DeleteForMeMenuItem_Click" />
                                                <MenuItem Header="Удалить у всех" Click="DeleteForEveryoneMenuItem_Click" Foreground="{DynamicResource FedMesDangerBrush}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                    </Border>
                                    <Border x:Name="MessageBubble"
                                            Grid.Column="1"
                                            MaxWidth="660"
                                            Padding="10,8"
                                            HorizontalAlignment="{Binding Alignment}"
                                            Background="{DynamicResource FedMesIncomingBubbleBrush}"
                                            BorderBrush="{DynamicResource FedMesDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Tag="{Binding}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="SenderNameText" Margin="0,0,0,3"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource FedMesNameTextBrush}"
                                                       Text="{Binding SenderName}"
                                                       Visibility="{Binding IsMine, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FedMesAccentBrush}"
                                                       Text="{Binding ForwardedFromDisplay, StringFormat=Переслано от {0}}"
                                                       Visibility="{Binding IsForwarded, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Margin="0,4,0,5"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="{DynamicResource FedMesQuoteBackgroundBrush}"
                                                    BorderThickness="0"
                                                    Click="ReplyPreviewButton_Click"
                                                    Visibility="{Binding HasReply, Converter={StaticResource BoolToVisibility}}">
                                                <Grid MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource FedMesQuoteBarBrush}" CornerRadius="3" />
                                                    <TextBlock Grid.Column="1" MaxWidth="560" Margin="9,6" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource FedMesMessageTextBrush}" Text="{Binding ReplyPreview}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Margin="0,2,7,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FedMesQuoteMarksBrush}" Text="”" />
                                                </Grid>
                                            </Button>
                                            <controls:RichMessageTextBlock Margin="2,1,2,5"
                                                                           FontSize="15"
                                                                           Foreground="{DynamicResource FedMesMessageTextBrush}"
                                                                           PlainText="{Binding Text}"
                                                                           TextEntities="{Binding TextEntities}"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />

                                            <Button Margin="2,2,2,5"
                                                    Padding="16,10"
                                                    Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                                                    BorderThickness="0"
                                                    Click="RevealSpoilerButton_Click"
                                                    Content="Показать скрытый текст"
                                                    Visibility="{Binding ShouldHideTextSpoiler, Converter={StaticResource BoolToVisibility}}" />

                                            <ItemsControl x:Name="MediaItemsControl"
                                                          ItemsSource="{Binding Media}"
                                                          Visibility="{Binding ShowStandardMedia, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="210"
                                                                Height="154"
                                                                Margin="2"
                                                                Click="MediaButton_Click"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="Background" Value="{DynamicResource FedMesSecondarySurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource FedMesDividerBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="MediaTileBorder"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="12"
                                                                                        ClipToBounds="True">
                                                                                    <ContentPresenter />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="MediaTileBorder" Property="Opacity" Value="0.94" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsPlainMedia, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Grid ClipToBounds="True">
                                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                                                                    <TextBlock MaxWidth="180" Margin="8,6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource FedMesPrimaryTextBrush}" Text="{Binding MediaKindLabel}" />
                                                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="{Binding SizeText}" />
                                                                </StackPanel>
                                                                <Border Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource FedMesOverlayBrush}" CornerRadius="26" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="White" Text="▶" />
                                                                </Border>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="6,3" Background="{DynamicResource FedMesOverlayBrush}" CornerRadius="7" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Foreground="White" FontSize="11" Text="{Binding DurationText, FallbackValue=Видео}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Margin="2,4"
                                                    Padding="12,9"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                                                    BorderBrush="{DynamicResource FedMesDividerBrush}"
                                                    BorderThickness="1"
                                                    Click="AudioButton_Click"
                                                    Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="54" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42" Height="42" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="21">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" Foreground="White" Text="▶" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FedMesPrimaryTextBrush}" Text="{Binding KindLabel}" />
                                                        <TextBlock Margin="0,4,0,0" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource FedMesAccentBrush}" Text="{Binding WaveformText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="{Binding DurationText}" />
                                                </Grid>
                                            </Button>

                                            <views:RoundVideoInlineControl Margin="2,4"
                                                                           HorizontalAlignment="Left"
                                                                           SourcePath="{Binding RoundVideoPath}"
                                                                           PreviewSource="{Binding Media[0].Preview}"
                                                                           Shape="{Binding RoundShape}"
                                                                           SourceRequested="RoundVideo_SourceRequested"
                                                                           Visibility="{Binding ShowRoundVideo, Converter={StaticResource BoolToVisibility}}" />

                                            <Border Margin="0,4,0,0"
                                                    Padding="16"
                                                    Background="{DynamicResource FedMesOverlayBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{Binding ShouldHideSpoiler, Converter={StaticResource BoolToVisibility}}">
                                                <Button Padding="18,9" Click="RevealSpoilerButton_Click" Content="Показать скрытое медиа" Style="{StaticResource PrimaryButtonStyle}" />
                                            </Border>

                                            <Border x:Name="MessageMetaBorder"
                                                    Margin="3,5,1,0"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Panel.ZIndex="8">
                                                <DockPanel LastChildFill="False">
                                                    <Grid Width="15" Height="15" Margin="6,0,0,0" DockPanel.Dock="Right"
                                                          Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                        <Ellipse Stroke="{DynamicResource FedMesPendingBrush}" StrokeThickness="1.7" />
                                                        <Line x:Name="PendingClockHand" X1="7.5" Y1="7.5" X2="7.5" Y2="3.3"
                                                              Stroke="{DynamicResource FedMesPendingBrush}" StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Line.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </Line.RenderTransform>
                                                        </Line>
                                                        <Line X1="7.5" Y1="7.5" X2="10.2" Y2="7.5"
                                                              Stroke="{DynamicResource FedMesPendingBrush}" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Grid>
                                                    <TextBlock x:Name="DeliveryStateText" DockPanel.Dock="Right" Margin="7,0,0,0"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FedMesAckBrush}"
                                                               Text="{Binding DeliveryText}"
                                                               Visibility="{Binding IsPending, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource FedMesMessageMetaBrush}" Text="{Binding TimeText}" />
                                                    <TextBlock DockPanel.Dock="Right" Margin="0,0,6,0" FontSize="10" Foreground="{DynamicResource FedMesMessageMetaBrush}" Text="скрыто" Visibility="{Binding IsOwnSpoiler, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock DockPanel.Dock="Right" Margin="0,0,6,0" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource FedMesMessageMetaBrush}" Text="изменено" Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                        <Border Background="{DynamicResource FedMesWarningBrush}" Opacity="0.30" CornerRadius="12" IsHitTestVisible="False" Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource FedMesOutgoingBubbleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="PendingClockStoryboard">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="PendingClockHand"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PendingClockStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRoundVideo}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="Transparent" />
                                        <Setter TargetName="MessageBubble" Property="BorderThickness" Value="0" />
                                        <Setter TargetName="MessageBubble" Property="Padding" Value="0" />
                                        <Setter TargetName="MessageMetaBorder" Property="Margin" Value="0,-31,7,7" />
                                        <Setter TargetName="MessageMetaBorder" Property="Background" Value="{DynamicResource FedMesMessageMetaOverlayBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlainMedia}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="Transparent" />
                                        <Setter TargetName="MessageBubble" Property="BorderThickness" Value="0" />
                                        <Setter TargetName="MessageBubble" Property="Padding" Value="0" />
                                        <Setter TargetName="MessageMetaBorder" Property="Margin" Value="0,-31,7,7" />
                                        <Setter TargetName="MessageMetaBorder" Property="Background" Value="{DynamicResource FedMesMessageMetaOverlayBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Center" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource FedMesSecondarySurfaceBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource FedMesSelectedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                        <Setter TargetName="DeliveryStateText" Property="Foreground" Value="{DynamicResource FedMesAckBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="ScrollToBottomButton"
                            Width="48" Height="48" Margin="0,0,22,20"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Panel.ZIndex="5"
                            Background="{DynamicResource FedMesAccentBrush}"
                            BorderThickness="0"
                            Click="ScrollToBottomButton_Click"
                            Visibility="Collapsed"
                            ToolTip="Вниз">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="24">
                                    <Path Width="20" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="Black" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L10,10 L18,2" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ProgressBar Width="120" Height="5" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Grid.Row="4" Margin="16,0,16,8" Padding="12,8" Background="{DynamicResource FedMesSurfaceBrush}" CornerRadius="12" Visibility="{Binding UploadVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="Загрузка вложения…" />
                            <ProgressBar Margin="0,6,0,0" Height="5" Maximum="100" Value="{Binding UploadProgress}" />
                        </StackPanel>
                        <Button x:Name="CancelUploadButton" Grid.Column="1" Content="×" Click="CancelUploadButton_Click" Style="{StaticResource IconButtonStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Row="5" Margin="16,0,16,6" Padding="10,7" Background="{DynamicResource FedMesSurfaceBrush}" CornerRadius="12" Visibility="{Binding HasComposerContext, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource FedMesAccentBrush}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FedMesAccentBrush}" Text="{Binding ComposerContextTitle}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="{Binding ComposerContextText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="×" Click="CancelComposerContextButton_Click" Style="{StaticResource IconButtonStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Row="6" Margin="16,0,16,14" Padding="6" Background="{DynamicResource FedMesSurfaceBrush}" CornerRadius="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton" Click="AttachButton_Click" Style="{StaticResource IconButtonStyle}" FocusVisualStyle="{x:Null}" ToolTip="Добавить вложение" AutomationProperties.Name="Добавить вложение">
                            <Viewbox Width="23" Height="23">
                                <Path Fill="{DynamicResource FedMesPrimaryTextBrush}"
                                      Stretch="Uniform"
                                      Data="M16.5,6.5 L16.5,17 C16.5,19.21 14.71,21 12.5,21 C10.29,21 8.5,19.21 8.5,17 L8.5,5.5 C8.5,3.57 10.07,2 12,2 C13.93,2 15.5,3.57 15.5,5.5 L15.5,16 C15.5,17.38 14.38,18.5 13,18.5 C11.62,18.5 10.5,17.38 10.5,16 L10.5,6 L12,6 L12,16 C12,16.55 12.45,17 13,17 C13.55,17 14,16.55 14,16 L14,5.5 C14,4.4 13.1,3.5 12,3.5 C10.9,3.5 10,4.4 10,5.5 L10,17 C10,18.38 11.12,19.5 12.5,19.5 C13.88,19.5 15,18.38 15,17 L15,6.5 Z" />
                            </Viewbox>
                        </Button>
                        <Border Grid.Column="1" Margin="2,0,4,0" Background="{DynamicResource FedMesFormattingSurfaceBrush}" BorderBrush="{DynamicResource FedMesFormattingBorderBrush}" BorderThickness="1" CornerRadius="18">
                            <TextBox x:Name="MessageTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="42"
                                     MaxHeight="150"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource FedMesFormattingTextBrush}"
                                     CaretBrush="{DynamicResource FedMesAccentBrush}"
                                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                                     TextChanged="MessageTextBox_TextChanged"
                                     GotKeyboardFocus="MessageTextBox_GotKeyboardFocus"
                                     Style="{StaticResource ComposerTextBoxStyle}">
                                <TextBox.ContextMenu>
                                    <ContextMenu Background="{DynamicResource FedMesFormattingSurfaceBrush}" Foreground="{DynamicResource FedMesFormattingTextBrush}">
                                        <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut" />
                                        <MenuItem Header="Копировать" Command="ApplicationCommands.Copy" />
                                        <MenuItem Header="Цитировать" Click="QuoteSelectionMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Жирный" FontWeight="Bold" Click="BoldSelectionMenuItem_Click" />
                                        <MenuItem Header="Курсив" FontStyle="Italic" Click="ItalicSelectionMenuItem_Click" />
                                        <MenuItem Header="Моно" FontFamily="Consolas" Click="MonospaceSelectionMenuItem_Click" />
                                        <MenuItem Click="StrikethroughSelectionMenuItem_Click">
                                            <MenuItem.Header>
                                                <TextBlock Text="Зачёркнутый" TextDecorations="Strikethrough" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Click="UnderlineSelectionMenuItem_Click">
                                            <MenuItem.Header>
                                                <TextBlock Text="Подчёркнутый" TextDecorations="Underline" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Header="Скрытый текст" Click="SpoilerSelectionMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Обычный" Click="ClearFormattingMenuItem_Click" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </Border>
                        <Button x:Name="FormattingButton" Grid.Column="2" Content="⋮" Click="FormattingButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Формат текста" Visibility="Collapsed" />
                        <Button x:Name="RoundVideoButton" Grid.Column="3" Content="◉" Click="RoundVideoButton_Click" Style="{StaticResource ComposerActionButtonStyle}" ToolTip="Видеосообщение" />
                        <Button x:Name="VoiceButton" Grid.Column="4" Content="🎤" Click="VoiceButton_Click" Style="{StaticResource ComposerActionButtonStyle}" ToolTip="Голосовое сообщение" />
                        <Button x:Name="SendButton" Grid.Column="4" Content="➤" Click="SendButton_Click" Style="{StaticResource ComposerActionButtonStyle}" ToolTip="Отправить" AutomationProperties.Name="Отправить сообщение" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="CallOverlay"
              Panel.ZIndex="9"
              Background="#0E1621"
              Visibility="{Binding Call.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Image Source="{Binding Call.RemoteVideo}" Stretch="UniformToFill" />
                <Border Width="132" Height="132" CornerRadius="66" Background="#202B36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="54" FontWeight="SemiBold" Foreground="#F4F7FA" Text="F" />
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,250,0,0">
                    <TextBlock HorizontalAlignment="Center" Foreground="#F4F7FA" FontSize="26" FontWeight="SemiBold" Text="{Binding Call.PeerTitle}" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#8E9DAA" FontSize="14" Text="{Binding Call.Status}" />
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="#F4F7FA" FontSize="20" Text="🔐  🐋  🔑  ✨" />
                </StackPanel>

                <Border Width="180" Height="240" Margin="0,86,22,0" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="18" Background="#17212B">
                    <Image Source="{Binding Call.LocalVideo}" Stretch="UniformToFill" />
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Call.HasLocalVideo}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Margin="28,0,28,36" VerticalAlignment="Bottom">
                    <Grid x:Name="IncomingCallActions">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Call.IsIncoming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="60" Click="DeclineCallButton_Click" Content="Отклонить" Foreground="White" Background="#E34B4B" BorderThickness="0" FontSize="16" FontWeight="SemiBold" />
                        <Button Grid.Column="2" Height="60" Click="AcceptCallButton_Click" Content="Принять" Foreground="White" Background="#2FA866" BorderThickness="0" FontSize="16" FontWeight="SemiBold" />
                    </Grid>
                    <fedui:FedMes26CallTray x:Name="DesktopCallTray"
                                            Height="104"
                                            Mode="{Binding Call.FedUiMode}"
                                            Muted="{Binding Call.Muted}"
                                            Speaker="{Binding Call.SpeakerEnabled}"
                                            Camera="{Binding Call.CameraEnabled}"
                                            MuteInvoked="DesktopCallTray_MuteInvoked"
                                            SpeakerInvoked="DesktopCallTray_SpeakerInvoked"
                                            CameraInvoked="DesktopCallTray_CameraInvoked"
                                            EndInvoked="DesktopCallTray_EndInvoked">
                        <fedui:FedMes26CallTray.Style>
                            <Style TargetType="fedui:FedMes26CallTray">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Call.IsIncoming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fedui:FedMes26CallTray.Style>
                    </fedui:FedMes26CallTray>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="LoginPanel" Background="{DynamicResource FedMesBackgroundBrush}">
            <Border Padding="26"
                    Margin="20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    MaxWidth="470"
                    Background="{DynamicResource FedMesSurfaceBrush}"
                    CornerRadius="26">
                <Grid>
                    <StackPanel x:Name="WelcomePanel">
                        <Border Width="84" Height="84" Margin="0,0,0,20" HorizontalAlignment="Center" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="42">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="42" FontWeight="Bold" Foreground="White" Text="F" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource FedMesPrimaryTextBrush}" Text="FedMes" />
                        <TextBlock Margin="0,10,0,24" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="15" LineHeight="22" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="Подключите компьютер через доверенный телефон." />
                        <Button x:Name="StartLoginButton" Click="StartLoginButton_Click" Content="Войти по QR" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="OpaqueLoginButton" Margin="0,10,0,0" Click="OpaqueLoginButton_Click" Content="Войти по парольной фразе" Style="{StaticResource SurfaceButtonStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="WelcomeStatusText" MinHeight="42" Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="На телефоне откройте Настройки → Устройства." />
                        <Expander Margin="0,10,0,0" Header="Параметры подключения" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Visibility="Collapsed">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="4,0,4,6" Text="Адрес сервера" />
                                <TextBox x:Name="ServerUrlTextBox" Height="44" VerticalContentAlignment="Center" Text="https://support-walrus.msk.ru" Style="{StaticResource FedMesTextBoxStyle}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="QrPanel" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource FedMesPrimaryTextBrush}" Text="Вход по QR-коду" />
                        <TextBlock Margin="0,10,0,18" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="На телефоне откройте Настройки → Устройства → Подключить Desktop и отсканируйте код." />
                        <Border Width="310" Height="310" Padding="14" HorizontalAlignment="Center" Background="White" BorderBrush="{DynamicResource FedMesDividerBrush}" BorderThickness="1" CornerRadius="22">
                            <Grid>
                                <Image x:Name="QrImage" Stretch="Uniform" />
                                <ProgressBar x:Name="QrProgress" Width="72" Height="5" IsIndeterminate="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="QrStatusText" MinHeight="48" Margin="0,18,0,12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="Создание защищённого QR…" />
                        <Button x:Name="RetryLoginButton" Margin="0,0,0,8" Click="StartLoginButton_Click" Content="Создать новый QR" Style="{StaticResource SurfaceButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="CancelLoginButton" Click="CancelLoginButton_Click" Content="Отмена" Padding="24,12" Background="Transparent" BorderBrush="{DynamicResource FedMesDividerBrush}" BorderThickness="1" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SplashPanel" Panel.ZIndex="10" Background="{DynamicResource FedMesBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="96" Height="96" HorizontalAlignment="Center" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="48">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="White" Text="F" />
                </Border>
                <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource FedMesPrimaryTextBrush}" Text="FedMes" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource FedMesSecondaryTextBrush}" Text="" />
                <ProgressBar Width="96" Height="4" Margin="0,24,0,0" IsIndeterminate="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
