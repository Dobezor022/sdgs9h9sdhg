<Window x:Class="FedMes.Desktop.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фото — FedMes"
        Width="1100"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#0F1720"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Grid Background="#0F1720">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E6000000" Panel.ZIndex="3">
            <Grid Margin="14,0">
                <TextBlock x:Name="TitleText"
                           MaxWidth="620"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="44" Height="44" Margin="0,7"
                            Click="ZoomOutButton_Click" Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="22" Cursor="Hand" Content="−" />
                    <Button Width="62" Height="44" Margin="0,7"
                            Click="ResetZoomButton_Click" Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="13" Cursor="Hand">
                        <TextBlock x:Name="ZoomText" Text="100%" />
                    </Button>
                    <Button Width="44" Height="44" Margin="0,7"
                            Click="ZoomInButton_Click" Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="22" Cursor="Hand" Content="+" />
                    <Button Width="44" Height="44" Margin="8,7,0,7"
                            Click="CloseButton_Click" Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="22" Cursor="Hand" Content="×" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ImageScrollViewer"
                      Grid.Row="1"
                      Background="#0F1720"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      CanContentScroll="False"
                      PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
            <Grid x:Name="ImageHost"
                  MinWidth="1"
                  MinHeight="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#0F1720">
                <Image x:Name="PhotoImage"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Fill"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
