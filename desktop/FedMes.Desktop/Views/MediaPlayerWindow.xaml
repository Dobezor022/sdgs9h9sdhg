<Window x:Class="FedMes.Desktop.Views.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медиа — FedMes"
        Width="1120"
        Height="720"
        MinWidth="680"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="Black"
        Foreground="White"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed"
        MouseMove="Window_MouseMove">
    <Window.Resources>
        <Style x:Key="PlayerIconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Background="Black" ClipToBounds="True">
        <MediaElement x:Name="Player"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="Uniform"
                      Volume="1"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      MediaFailed="Player_MediaFailed">
            <MediaElement.LayoutTransform>
                <RotateTransform x:Name="PlayerRotation" Angle="0" />
            </MediaElement.LayoutTransform>
        </MediaElement>

        <Border x:Name="AudioPlaceholder"
                Width="230"
                Height="230"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF17202A"
                CornerRadius="115"
                Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="92"
                       Foreground="#DFFFFFFF"
                       Text="♫" />
        </Border>

        <Button x:Name="CenterPlayButton"
                Width="78"
                Height="78"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#B0000000"
                BorderThickness="0"
                Foreground="White"
                FontSize="32"
                Cursor="Hand"
                Click="PlayPauseButton_Click"
                Content="▶" />

        <Grid x:Name="ControlsOverlay" Background="#26000000">
            <Border Height="64" VerticalAlignment="Top" Background="#B0000000">
                <Grid Margin="18,0,10,0">
                    <TextBlock x:Name="TitleText"
                               MaxWidth="900"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <Button Width="44"
                            Height="44"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="24"
                            Cursor="Hand"
                            Content="×" />
                </Grid>
            </Border>

            <Border VerticalAlignment="Bottom"
                    Padding="15,9,15,12"
                    Background="#D9000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <Slider x:Name="PositionSlider"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            PreviewMouseDown="PositionSlider_PreviewMouseDown"
                            PreviewMouseUp="PositionSlider_PreviewMouseUp"
                            ValueChanged="PositionSlider_ValueChanged" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayPauseButton"
                                Grid.Column="0"
                                Style="{StaticResource PlayerIconButton}"
                                Click="PlayPauseButton_Click"
                                Content="▶"
                                ToolTip="Воспроизвести / пауза" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PlayerIconButton}"
                                Click="RewindButton_Click"
                                Content="↶10"
                                FontSize="15"
                                ToolTip="Назад на 10 секунд" />
                        <Button Grid.Column="2"
                                Style="{StaticResource PlayerIconButton}"
                                Click="ForwardButton_Click"
                                Content="10↷"
                                FontSize="15"
                                ToolTip="Вперёд на 10 секунд" />
                        <Button x:Name="MuteButton"
                                Grid.Column="3"
                                Style="{StaticResource PlayerIconButton}"
                                Click="MuteButton_Click"
                                Content="🔊"
                                FontSize="16"
                                ToolTip="Звук" />
                        <Slider x:Name="VolumeSlider"
                                Grid.Column="4"
                                Width="145"
                                Margin="4,0,10,0"
                                Minimum="0"
                                Maximum="1"
                                Value="1"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock x:Name="TimeText"
                                   Grid.Column="5"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   Text="0:00 / 0:00" />
                        <ComboBox x:Name="SpeedComboBox"
                                  Grid.Column="6"
                                  Width="84"
                                  Height="32"
                                  Margin="8,0"
                                  SelectedIndex="2"
                                  VerticalAlignment="Center"
                                  SelectionChanged="SpeedComboBox_SelectionChanged">
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                            <ComboBoxItem Content="1×" Tag="1" />
                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="2×" Tag="2" />
                        </ComboBox>
                        <Button x:Name="FullscreenButton"
                                Grid.Column="7"
                                Style="{StaticResource PlayerIconButton}"
                                Click="FullscreenButton_Click"
                                Content="⛶"
                                ToolTip="На весь экран" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
