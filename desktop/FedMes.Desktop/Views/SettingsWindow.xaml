<Window x:Class="FedMes.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки FedMes"
        Width="780"
        Height="700"
        MinWidth="680"
        MinHeight="570"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FedMesBackgroundBrush}">
    <Grid Margin="18">
        <Border Background="{DynamicResource FedMesSurfaceBrush}"
                BorderBrush="{DynamicResource FedMesDividerBrush}"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource FedMesDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Button Content="←" Click="CloseButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Назад" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="Настройки" />
                        <Button Grid.Column="2" Content="⟳" Click="RefreshButton_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Обновить устройства" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,8">
                        <Border Padding="16"
                                Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                                CornerRadius="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="UserAvatarBorder" Width="64" Height="64" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="32">
                                    <TextBlock x:Name="UserAvatarText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,2,0,0">
                                    <TextBlock x:Name="UserText" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ServerText"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="4,20,0,8"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FedMesAccentBrush}"
                                   Text="КОНФИДЕНЦИАЛЬНОСТЬ" />
                        <Border Padding="16"
                                Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                                CornerRadius="16">
                            <StackPanel>
                                <CheckBox x:Name="ShowExactPresenceCheckBox"
                                          Padding="2,6"
                                          Content="Показывать точное время последнего посещения"
                                          Checked="ShowExactPresenceCheckBox_Changed"
                                          Unchecked="ShowExactPresenceCheckBox_Changed" />
                                <TextBlock Margin="27,0,0,4"
                                           FontSize="12"
                                           Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                           Text="То же состояние используется Android-клиентом." />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="4,20,0,8"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FedMesAccentBrush}"
                                   Text="ОФОРМЛЕНИЕ" />
                        <Border Padding="16"
                                Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                                CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Тема" />
                                <UniformGrid Margin="0,11,0,0" Columns="3">
                                    <RadioButton x:Name="SystemThemeRadio"
                                                 GroupName="Theme"
                                                 Tag="System"
                                                 Padding="2,5"
                                                 Content="Системная"
                                                 Checked="ThemeRadio_Checked" />
                                    <RadioButton x:Name="LightThemeRadio"
                                                 GroupName="Theme"
                                                 Tag="Light"
                                                 Padding="2,5"
                                                 Content="Светлая"
                                                 Checked="ThemeRadio_Checked" />
                                    <RadioButton x:Name="DarkThemeRadio"
                                                 GroupName="Theme"
                                                 Tag="Dark"
                                                 Padding="2,5"
                                                 Content="Тёмная"
                                                 Checked="ThemeRadio_Checked" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="4,20,0,8">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource FedMesAccentBrush}"
                                       Text="УСТРОЙСТВА" />
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                       Text="Активные сеансы FedMes" />
                        </Grid>
                        <ListBox x:Name="DevicesListBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                                            BorderBrush="{DynamicResource FedMesDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="118" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" Background="{DynamicResource FedMesAccentBrush}" CornerRadius="20">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" Text="▣" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <Border Margin="8,1,0,0"
                                                            Padding="6,2"
                                                            Background="{DynamicResource FedMesAccentBrush}"
                                                            CornerRadius="8"
                                                            Visibility="{Binding Current, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock FontSize="10" Foreground="White" Text="ТЕКУЩЕЕ" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                                           Text="{Binding Platform}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                                           Text="{Binding LastSeenAt, StringFormat=Последняя активность: {0:g}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Padding="10,7"
                                                    Click="RevokeDeviceButton_Click"
                                                    Content="Отключить"
                                                    Tag="{Binding}"
                                                    Foreground="{DynamicResource FedMesDangerBrush}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SurfaceButtonStyle}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Current}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="16,12"
                        BorderBrush="{DynamicResource FedMesDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                   Text="Настройки сохраняются только на этом компьютере." />
                        <Button Grid.Column="1"
                                Click="TerminateOthersButton_Click"
                                Content="Завершить другие сеансы"
                                Style="{StaticResource SurfaceButtonStyle}" />
                        <Button Grid.Column="3"
                                Click="SignOutButton_Click"
                                Content="Отключить этот компьютер"
                                Foreground="{DynamicResource FedMesDangerBrush}"
                                Style="{StaticResource SurfaceButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
