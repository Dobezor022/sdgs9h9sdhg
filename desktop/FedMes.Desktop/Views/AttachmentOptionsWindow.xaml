<Window x:Class="FedMes.Desktop.Views.AttachmentOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отправка вложений"
        Width="500"
        Height="510"
        MinWidth="500"
        MinHeight="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FedMesBackgroundBrush}">
    <Border Margin="18"
            Padding="24"
            Background="{DynamicResource FedMesSurfaceBrush}"
            BorderBrush="{DynamicResource FedMesDividerBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold" Text="Отправить вложения" />
                <TextBlock x:Name="FilesText"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="12"
                    Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                    CornerRadius="15">
                <StackPanel>
                    <TextBlock Margin="2,0,0,7" FontWeight="SemiBold" Text="Подпись" />
                    <TextBox x:Name="CaptionTextBox"
                             Height="82"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource FedMesTextBoxStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <CheckBox x:Name="SendAsFileCheckBox"
                          Padding="2,5"
                          Content="Отправить без сжатия как файл" />
                <CheckBox x:Name="SpoilerCheckBox"
                          Margin="0,7,0,0"
                          Padding="2,5"
                          Content="Скрыть медиа под спойлером" />
                <CheckBox x:Name="RoundVideoCheckBox"
                          Margin="0,7,0,0"
                          Padding="2,5"
                          Content="Отправить как видеосообщение"
                          Checked="RoundVideoCheckBox_Changed"
                          Unchecked="RoundVideoCheckBox_Changed" />

                <Border x:Name="RoundShapePanel"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource FedMesSecondarySurfaceBrush}"
                        CornerRadius="14"
                        IsEnabled="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Форма видеосообщения" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                                       Text="Та же форма будет видна на Android и Desktop." />
                        </StackPanel>
                        <ComboBox x:Name="RoundShapeComboBox"
                                  Grid.Column="1"
                                  Height="38"
                                  Margin="12,0,0,0"
                                  SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Круг" Tag="Circle" />
                            <ComboBoxItem Content="Квадрат" Tag="Square" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="128" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource FedMesSecondaryTextBrush}"
                           Text="Без установленного лимита размера" />
                <Button Grid.Column="1"
                        Click="CancelButton_Click"
                        Content="Отмена"
                        Style="{StaticResource SurfaceButtonStyle}" />
                <Button Grid.Column="3"
                        Click="SendButton_Click"
                        Content="Отправить"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
