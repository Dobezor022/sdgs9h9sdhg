<Application x:Class="FedMes.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FedMes.Desktop.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Same visual tokens as the Android Jetpack Compose client. -->
        <SolidColorBrush x:Key="FedMesAccentBrush" Color="#3390EC" />
        <SolidColorBrush x:Key="FedMesAccentHoverBrush" Color="#2B7FC6" />
        <SolidColorBrush x:Key="FedMesBackgroundBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="FedMesChatBackgroundBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="FedMesSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FedMesSecondarySurfaceBrush" Color="#EDF2F6" />
        <SolidColorBrush x:Key="FedMesPrimaryTextBrush" Color="#17212B" />
        <SolidColorBrush x:Key="FedMesSecondaryTextBrush" Color="#70808D" />
        <SolidColorBrush x:Key="FedMesDividerBrush" Color="#DCE5EC" />
        <SolidColorBrush x:Key="FedMesIncomingBubbleBrush" Color="#E1FFC7" />
        <SolidColorBrush x:Key="FedMesOutgoingBubbleBrush" Color="#E1FFC7" />
        <SolidColorBrush x:Key="FedMesHoverBrush" Color="#EDF2F6" />
        <SolidColorBrush x:Key="FedMesSelectedBrush" Color="#EDF2F6" />
        <SolidColorBrush x:Key="FedMesDangerBrush" Color="#E14B4B" />
        <SolidColorBrush x:Key="FedMesOnlineBrush" Color="#31B77A" />
        <SolidColorBrush x:Key="FedMesWarningBrush" Color="#E8A33A" />
        <SolidColorBrush x:Key="FedMesOverlayBrush" Color="#99000000" />
        <SolidColorBrush x:Key="FedMesMessageTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="FedMesNameTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="FedMesQuoteBackgroundBrush" Color="#D9DDE1" />
        <SolidColorBrush x:Key="FedMesQuoteBarBrush" Color="#F7F8F9" />
        <SolidColorBrush x:Key="FedMesQuoteMarksBrush" Color="#66727C" />
        <SolidColorBrush x:Key="FedMesFormattingSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FedMesFormattingBorderBrush" Color="#79C8F2" />
        <SolidColorBrush x:Key="FedMesFormattingTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="FedMesAckBrush" Color="#3B88C3" />
        <SolidColorBrush x:Key="FedMesPendingBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="FedMesMessageMetaBrush" Color="#000000" />
        <SolidColorBrush x:Key="FedMesMessageMetaOverlayBrush" Color="#CCFFFFFF" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:RoundShapeGeometryConverter x:Key="RoundShapeGeometry" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{DynamicResource FedMesAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource FedMesAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource FedMesHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ComposerActionButtonStyle" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="{DynamicResource FedMesAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource FedMesAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SurfaceButtonStyle">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource FedMesSecondarySurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FedMesDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource FedMesHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ComposerTextBoxStyle">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource FedMesAccentBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="TextBox" x:Key="FedMesTextBoxStyle">
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource FedMesSecondarySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FedMesDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FedMesPrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Resources>
</Application>
