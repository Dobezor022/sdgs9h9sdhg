root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{go,json,jsonc,yaml,yml,xml,ps1,cs,csproj,props,sln}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4


